{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm --prefix Soul_of_Meal_COMPLETE_SPEC_v3/Soul_of_Meal_COMPLETE_SPEC_v3/client ci",
  "buildCommand": "npm --prefix Soul_of_Meal_COMPLETE_SPEC_v3/Soul_of_Meal_COMPLETE_SPEC_v3/client run build",
  "outputDirectory": "Soul_of_Meal_COMPLETE_SPEC_v3/Soul_of_Meal_COMPLETE_SPEC_v3/client/dist",
  "trailingSlash": true,
  "redirects": [
    { "source": "/", "destination": "/client/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/client/", "destination": "/client/index.html" }
  ]
}
